{
  "name": "@internal-better-auth-gateway/app",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "cd .. && husky ./app/.husky",
    "with-env": "dotenv -e .env --",
    "auth:generate": "pnpm with-env auth generate --config ./src/features/auth/clients/server-client.ts --output ./src/db/schema/auth-schema.ts --yes",
    "db:generate": "pnpm with-env drizzle-kit generate --config ./src/db/config/db-config.ts",
    "db:migrate": "pnpm with-env drizzle-kit migrate --config ./src/db/config/db-config.ts",
    "db:push": "pnpm with-env drizzle-kit push --config ./src/db/config/db-config.ts",
    "db:pull": "pnpm with-env drizzle-kit pull --config ./src/db/config/db-config.ts",
    "db:studio": "pnpm with-env drizzle-kit studio --config ./src/db/config/db-config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "generate-routes": "tsr generate",
    "dev": "vite dev --port 3000",
    "preview": "vite preview",
    "build": "vite build"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.2",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "1.7.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "lint-staged": {
    "*": "pnpm lint"
  }
}
